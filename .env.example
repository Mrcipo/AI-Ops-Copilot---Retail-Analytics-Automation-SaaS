APP_ENV=local
LOG_LEVEL=INFO
DEFAULT_TENANT_ID=demo

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Inside Docker Compose the database is reachable at postgres:5432.
# 5435 is only the port mapped on the host. Keep the password in sync with POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://postgres:change_me@postgres:5432/postgres

REDIS_URL=redis://redis:6379/0
